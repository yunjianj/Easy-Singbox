#!/usr/bin/env bash
# sb — easy-singbox 管理命令本体
# 首次运行由 install.sh exec 调用，安装后通过 /usr/local/bin/sb 软链调用。
# 两者都进入同一主页面。

set -euo pipefail
# 敏感文件（.state/.cf.env/nodes.txt 等）一律按 600 创建，避免默认 umask 022
# 在写入与 chmod 之间的窗口短暂暴露为 644。
umask 077

# 解析脚本真实目录（兼容软链）
SB_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# 脚本版本（发布新版本时同步修改此常量，并更新仓库根 VERSION 文件）
SB_SCRIPT_VERSION="1.2.11"

# 远程版本检测缓存（best-effort，避免每次打开菜单都请求网络）
SB_VER_CACHE="$SB_DIR/.script_ver"

# 自更新源（默认 GitHub raw 官方域名，避免第三方 CDN 缓存被投毒；可用环境变量覆盖）
SB_UPDATE_BASE="${SB_UPDATE_BASE:-https://raw.githubusercontent.com/yunjianj/Easy-Singbox/main}"

# ---------- 载入模块 ----------
source "$SB_DIR/lib/core.sh"
source "$SB_DIR/lib/init.sh"
source "$SB_DIR/lib/service.sh"
source "$SB_DIR/lib/firewall.sh"
source "$SB_DIR/lib/port_hop.sh"
source "$SB_DIR/lib/cert.sh"
source "$SB_DIR/lib/protocol/anytls.sh"
source "$SB_DIR/lib/protocol/hysteria2.sh"
source "$SB_DIR/lib/protocol/tuic.sh"
source "$SB_DIR/lib/config.sh"
source "$SB_DIR/lib/node.sh"
source "$SB_DIR/lib/diag.sh"

# ---------- sing-box 下载/安装 ----------
sb_latest_version() {
  local tag
  tag=$(curl -s --max-time 15 https://api.github.com/repos/SagerNet/sing-box/releases/latest \
    | tr ',' '\n' | grep '"tag_name"' | head -1 \
    | sed -E 's/.*:[[:space:]]*"([^"]+)".*/\1/' || true)
  tag=${tag#v}
  [[ -z "$tag" ]] && return 1
  echo "$tag"
}

sb_download() {
  local version=$1 arch=$2
  [[ -z "$version" || -z "$arch" ]] && { error "下载参数缺失（version/arch 为空）"; return 1; }
  local url="https://github.com/SagerNet/sing-box/releases/download/v${version}/sing-box-${version}-linux-${arch}.tar.gz"
  local tmp; tmp=$(mktemp -d)
  info "下载 sing-box v${version} (${arch}) ..."
  local http_code
  http_code=$(curl -sL --retry 3 --max-time 180 -o "$tmp/sb.tar.gz" -w '%{http_code}' "$url")
  if [[ "$http_code" != "200" ]]; then
    error "下载失败（HTTP $http_code）: $url"; rm -rf "$tmp"; return 1
  fi
  if ! gzip -t "$tmp/sb.tar.gz" 2>/dev/null; then
    error "下载文件不是有效的 gzip 压缩包（可能下载到了错误页面）: $url"; rm -rf "$tmp"; return 1
  fi

  # 供应链完整性校验（v1.2.3 简化）：
  # sing-box 官方 release 不附带 checksums.sha256，且 GitHub 的 asset digest 由 GitHub
  # 服务端签发、攻击者无法伪造，比"与二进制同 release 的 checksums 文件"更强，故不再
  # 保留 checksums 备选。校验锚点统一为 GitHub Release API digest；API 不可用或缺少
  # sha256sum/shasum 时显著警告并要求用户确认，绝不静默跳过。
  local sum_tool=""
  if command -v sha256sum >/dev/null 2>&1; then
    sum_tool="sha256sum"
  elif command -v shasum >/dev/null 2>&1; then
    sum_tool="shasum -a 256"
  fi

  local verified=0
  if [[ -n "$sum_tool" ]]; then
    local api_digest actual
    api_digest=$(curl -fsSL --retry 2 --max-time 20 "https://api.github.com/repos/SagerNet/sing-box/releases/tags/v${version}" 2>/dev/null \
      | awk -v want="sing-box-${version}-linux-${arch}.tar.gz" '
          /"name":/   { l=$0; sub(/.*"name": *"/,"",l); sub(/".*/,"",l); name=l }
          /"digest":/ && name==want { d=$0; sub(/.*"digest": *"sha256:/,"",d); sub(/".*/,"",d); print d; exit }
        ' || true)
    if [[ -n "$api_digest" ]]; then
      actual=$($sum_tool "$tmp/sb.tar.gz" 2>/dev/null | awk '{print $1}' || true)
      if [[ "$api_digest" == "$actual" ]]; then
        ok "GitHub API 官方 digest 校验通过（sha256:${actual}）"
        verified=1
      else
        error "sing-box 二进制 SHA256 校验失败，已拒绝安装（供应链安全风险）"
        info "期望(GitHub API): $api_digest"
        info "实际计算        : ${actual:-无法计算}"
        rm -rf "$tmp"; return 1
      fi
    fi
  fi

  if [[ $verified -eq 0 ]]; then
    warn "无法获取官方校验值（缺少 sha256sum/shasum，或 GitHub API 不可用）"
    if ! core_prompt_yn "确认在无完整性校验的情况下继续安装？"; then
      warn "已取消安装"; rm -rf "$tmp"; return 1
    fi
  fi

  tar -xzf "$tmp/sb.tar.gz" -C "$tmp"
  local bin; bin=$(find "$tmp" -name sing-box -type f | head -1)
  if [[ -z "$bin" ]]; then error "压缩包内未找到 sing-box 二进制"; rm -rf "$tmp"; return 1; fi
  install -m 755 "$bin" "$SB_BIN"
  rm -rf "$tmp"
  ok "sing-box v${version} 已安装到 $SB_BIN"
}

# ---------- 脚本自身版本检测 ----------
# 版本号来源优先级：GitHub API（实时，无 CDN 缓存延迟）→ raw 官方域名 → jsDelivr 镜像。
# 为何 API 优先：raw.githubusercontent.com 在刚推送后的数分钟内会返回旧版本（CDN 缓存），
# 导致所有设备把旧版本误判为"已是最新"、自更新失效（用户实测：同机重跑引导脚本走
# github.com 实时源即可正常更新，证明是 raw 源滞后）。
# 末尾 || true 屏蔽 SIGPIPE，避免 set -o pipefail 下整条管道非零触发 set -e 静默中止。
sb_script_latest() {
  local r
  # 主：GitHub API contents（VERSION 内容为 base64；JSON 中带字面 \n，须先剥掉再解码，
  # 否则 BusyBox base64 -d 会因非法字符解码失败）
  r=$(curl -s --max-time 6 "https://api.github.com/repos/yunjianj/Easy-Singbox/contents/VERSION?ref=main" 2>/dev/null \
    | grep -oE '"content"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 \
    | sed -E 's/.*"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/; s/\\n//g; s/\\r//g' \
    | base64 -d 2>/dev/null | tr -d '[:space:]v' || true)
  # 备1：raw 官方域名（API 限流/不可达时）
  if [[ -z "$r" ]]; then
    r=$(curl -s --max-time 6 "https://raw.githubusercontent.com/yunjianj/Easy-Singbox/main/VERSION" 2>/dev/null \
      | tr -d '[:space:]v' || true)
  fi
  # 备2：jsDelivr CDN 镜像
  if [[ -z "$r" ]]; then
    r=$(curl -s --max-time 6 "https://cdn.jsdelivr.net/gh/yunjianj/Easy-Singbox@main/VERSION" 2>/dev/null \
      | tr -d '[:space:]v' || true)
  fi
  # 仅接受语义版本（数字.数字.数字，允许 v 前缀）；拒绝 HTML/错误文本，避免误报
  [[ "$r" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && echo "$r" || true
}

# 带本地缓存的版本状态：缓存只存“干净的远程版本号”，10 分钟内复用；
# 非法值（错误页/HTML）绝不写入缓存，避免污染。检测失败返回 unknown。
sb_script_version_status() {
  local cur=$1 now cached_ts cached_ver r="" newer
  now=$(date +%s) || now=0
  if [[ -f "$SB_VER_CACHE" ]]; then
    IFS='|' read -r cached_ver cached_ts < "$SB_VER_CACHE" 2>/dev/null || true
    if [[ -n "$cached_ts" && -n "$cached_ver" && "$cached_ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ \
          && $((now - cached_ts)) -lt 600 ]]; then
      r="$cached_ver"
    fi
  fi
  if [[ -z "$r" ]]; then
    r=$(sb_script_latest) || true
    [[ -n "$r" ]] && echo "${r}|${now}" > "$SB_VER_CACHE" 2>/dev/null || true
  fi
  [[ -z "$r" ]] && { echo "unknown"; return; }
  [[ "$cur" == "$r" ]] && { echo "latest"; return; }
  newer=$(printf '%s\n%s\n' "$cur" "$r" | sort -V | tail -1) || true
  if [[ "$newer" == "$cur" ]]; then echo "latest"; else echo "update:$r"; fi
}

# ---------- 安装主流程 ----------
sb_install() {
  core_root_check
  if [[ -x "$SB_BIN" ]]; then
    warn "sing-box 已安装。如需重装请先执行卸载（主页面选项 1 -> 卸载）。"
    return 0
  fi

  local arch; arch=$(core_detect_arch)
  local ver; ver=${SB_VERSION_OVERRIDE:-$(sb_latest_version)}
  if [[ -z "$ver" ]]; then
    error "无法获取 sing-box 最新版本（可能网络受限或 GitHub API 不可达）。可指定版本重试：bash install.sh --version 1.13.0"
    return 1
  fi
  sb_download "$ver" "$arch" || return 1

  # 提前创建低权限用户，保证后续生成的配置/证书可被读取
  service_ensure_user
  # 立即建立管理命令软链：即使后续步骤（证书/服务启动）失败或卡住，sb 也始终可用
  chmod 755 "$SB_DIR/sb" 2>/dev/null || true
  ln -sf "$SB_DIR/sb" "$SB_SYMLINK" 2>/dev/null || true
  # 确保 IPv6 双栈监听（listen "::" 在 bindv6only=1 时仅监听 IPv6，致 IPv4 被 RST）
  core_ensure_dualstack

  # 证书 + 域名
  local domain mode token
  domain=$(core_prompt "节点域名（用于 TLS 证书与节点连接）" "")
  [[ -z "$domain" ]] && { error "域名不能为空"; return 1; }

  echo "证书验证方式："
  echo "  [1] HTTP-01（需 80 端口空闲 + 域名 A 记录指向本机）"
  echo "  [2] DNS-01 Cloudflare（需 CF API Token，无需 80）"
  mode=$(core_prompt "选择验证方式" "1")

  cert_install_acme || return 1
  if [[ "$mode" == "2" ]]; then
    token=$(core_prompt "Cloudflare API Token")
    cert_issue_dns01_cf "$domain" "$token" || return 1
  else
    cert_issue_http01 "$domain" || return 1
  fi

  # 凭证始终随机生成（不可记忆，无手动必要），端口才需要选择
  local pass_any pass_hy2 pass_tuic uuid
  pass_any=$(core_rand_pass); pass_hy2=$(core_rand_pass); pass_tuic=$(core_rand_pass)
  uuid=$(core_rand_uuid)
  info "证书就绪，正在生成凭证与端口（如长时间无输出请检查终端）..."

  # 三协议端口：随机生成 / 手动输入
  local port_any port_hy2 port_tuic port_way
  echo "三协议端口生成方式："
  echo "  [1] 随机（自动生成高位端口，三个端口互不相同）"
  echo "  [2] 手动输入（分别指定 AnyTLS / Hysteria2 / TUIC 端口）"
  port_way=$(core_prompt "选择" "1")
  case "$port_way" in
    2)
      while true; do
        port_any=$(core_prompt "AnyTLS 端口" "")
        port_hy2=$(core_prompt "Hysteria2 端口" "")
        port_tuic=$(core_prompt "TUIC 端口" "")
        if [[ "$port_any" =~ ^[0-9]+$ && "$port_hy2" =~ ^[0-9]+$ && "$port_tuic" =~ ^[0-9]+$ \
              && "$port_any" != "$port_hy2" && "$port_any" != "$port_tuic" && "$port_hy2" != "$port_tuic" \
              && "$port_any" -ge 1 && "$port_any" -le 65535 \
              && "$port_hy2" -ge 1 && "$port_hy2" -le 65535 \
              && "$port_tuic" -ge 1 && "$port_tuic" -le 65535 ]]; then
          break
        fi
        warn "端口需为 1-65535 的整数，且三个端口互不相同，请重新输入"
      done
      ;;
    *)
      port_any=$(core_rand_port); port_hy2=$(core_rand_port); port_tuic=$(core_rand_port)
      while [[ "$port_any" == "$port_hy2" || "$port_any" == "$port_tuic" || "$port_hy2" == "$port_tuic" ]]; do
        port_hy2=$(core_rand_port); port_tuic=$(core_rand_port)
      done
      ;;
  esac

  # Hysteria2 端口跳跃（增强抗封锁能力，默认段 50001-51000）
  echo "Hysteria2 端口跳跃："
  echo "  说明：sing-box 核心 inbound 不支持服务端端口跳跃，本脚本用 nftables/iptables REDIRECT"
  echo "  把跳跃段重定向到基础监听端口，回包由 conntrack 自动还原源端口，客户端 mport 跳变可用。"
  echo "  启用后节点 URI 将携带 mport=跳跃段，客户端会随机跳变入站端口，抗封锁更强。"
  local enable_hop hop_hy2=""
  enable_hop=$(core_prompt "是否启用 Hysteria2 端口跳跃(REDIRECT 冗余)" "y")
  case "$enable_hop" in
    n|N|no|NO)
      hop_hy2=""
      info "不启用 Hysteria2 端口跳跃"
      ;;
    *)
      hop_hy2=$(core_prompt "Hysteria2 跳跃段(留空使用默认 50001-51000)" "50001-51000")
      ;;
  esac

  # 端口开放策略（回车默认 [1]）
  echo "端口开放策略："
  echo "  [1] 全部（22/SSH + 80 + 三协议端口；跳跃段经 REDIRECT 自动生效）"
  echo "  [2] 开放所有端口（关闭防火墙）"
  echo "  [3] 不开放（手动在防火墙/安全组配置）"
  echo "  注意：切勿手动执行 ufw enable（脚本仅放行节点端口，未放行 22 会锁死 SSH）；本脚本已自动放行 22。"
  # Hysteria2 实际监听为基础端口 port_hy2；跳跃段由 lib/port_hop.sh 通过
  # REDIRECT 重定向到该端口，因此防火墙只需开放基础端口即可。
  local fwchoice; fwchoice=$(core_prompt "选择" "1")
  fw_apply_choice "$fwchoice" "$port_any" "$port_hy2" "$port_tuic"
  if [[ -n "$hop_hy2" ]]; then
    warn "已启用 Hysteria2 端口跳跃（$hop_hy2），节点 URI 将携带 mport=$hop_hy2。" \
         "本地防火墙只需放行基础端口 $port_hy2（跳跃段由 REDIRECT 自动转发）；" \
         "但客户端会向整个 UDP 范围随机发包，请务必在云安全组/上游防火墙放行 UDP $hop_hy2，" \
         "否则 Hysteria2 将无法连接（报超时）。"
  fi

  # 生成配置
  config_gen "$domain" "$port_any" "$port_hy2" "$port_tuic" \
             "$pass_any" "$pass_hy2" "$pass_tuic" "$uuid" "" "$hop_hy2" || return 1

  # 服务
  service_install
  service_start

  # 端口监听实况校验：服务 active 不代表端口 bind 成功（端口被占用时进程会反复退出），
  # 而客户端 "connection refused" 的直接原因正是此处无监听，故必须显式校验并中止。
  if ! service_verify_ports "$port_any" "$port_hy2" "$port_tuic"; then
    error "端口未正常监听，安装中止。请执行 sb → 选项 9 生成诊断报告后排查。"
    return 1
  fi

  # 外部可达性自测（best-effort）：从本机公网 IP 自连，区分“服务没在收”与“防火墙/安全组拦了”。
  # TCP RST（被主动拒绝）通常是“无监听”；而防火墙拦截多为超时——此步可立刻给出方向。
  local myip
  myip=$(curl -s --max-time 6 https://api.ipify.org 2>/dev/null || true)
  if [[ -n "$myip" ]]; then
    if timeout 3 bash -c "exec 3<>/dev/tcp/$myip/$port_any" 2>/dev/null; then
      ok "公网 IP $myip:$port_any 自连成功（入站路径通畅，客户端应可连接）"
    else
      warn "公网 IP $myip:$port_any 自连失败。若 127.0.0.1:$port_any 可连（见上方校验），" \
           "则是防火墙/云安全组未放行该 TCP 端口——请在服务器防火墙与云安全组放行" \
           " TCP $port_any、UDP $port_hy2、UDP $port_tuic 后客户端即可连接。"
    fi
  fi

  # 软链管理命令（失败不中断安装，sb 仍可通过绝对路径运行）
  # 必须先确保 sb 本体可执行：GitHub tarball 会保留执行位，但自更新时 curl 下载的
  # 文件是 0644，若复制成新文件会丢 +x，导致 "bash: /usr/local/bin/sb: Permission denied"。
  chmod 755 "$SB_DIR/sb" 2>/dev/null || true
  ln -sf "$SB_DIR/sb" "$SB_SYMLINK" 2>/dev/null || true
  ok "管理命令已链接: $SB_SYMLINK -> $SB_DIR/sb"

  # 节点输出
  node_gen
}

# ---------- 卸载 ----------
sb_uninstall() {
  core_root_check
  if [[ ! -x "$SB_BIN" && ! -f "$SB_CONF" ]]; then
    warn "未检测到已安装的 sing-box"
    return 0
  fi
  if ! core_prompt_yn "确认卸载 sing-box？将停止服务并删除二进制/配置（节点信息将丢失）"; then
    info "已取消卸载"; return 0
  fi
  # 清理 Hysteria2 端口跳跃重定向规则
  hop_remove
  service_remove_unit
  rm -f "$SB_BIN" "$SB_SYMLINK" "${SB_BIN}.bak"
  rm -f "$SB_CONF" "$SB_STATE" "$SB_NODES" "$SB_CF_ENV"
  if core_prompt_yn "同时删除证书目录 /etc/sing-box/ssl 与 acme.sh 账户(~/.acme.sh)？"; then
    rm -rf "$SB_DIR_SSL"
    rm -rf "$ACME_HOME"
    ok "已删除证书与 acme.sh 账户"
  else
    warn "保留证书目录与 acme.sh 账户"
  fi
  if [[ "$INIT_SYSTEM" == "openrc" ]]; then
    deluser singbox 2>/dev/null || true
  else
    userdel singbox 2>/dev/null || true
  fi
  ok "卸载完成"
}

# ---------- 版本切换（选项 7）----------
sb_version_menu() {
  core_root_check
  [[ -x "$SB_BIN" ]] || { error "尚未安装 sing-box"; return 1; }
  local latest; latest=$(sb_latest_version)
  info "最新版本: v$latest"
  local ver; ver=$(core_prompt "要切换到的版本（如 1.13.0，留空=最新）" "$latest")
  [[ -z "$ver" ]] && ver=$latest
  if [[ -z "$ver" ]]; then
    error "未获取到版本号，无法切换"; return 1
  fi
  local arch; arch=$(core_detect_arch)
  if [[ -f "$SB_BIN" ]]; then cp -f "$SB_BIN" "${SB_BIN}.bak" 2>/dev/null || true; fi
  if sb_download "$ver" "$arch"; then
    service_reload
    ok "已切换至 v$ver（旧版本备份: ${SB_BIN}.bak，可手动恢复）"
  else
    [[ -f "${SB_BIN}.bak" ]] && mv -f "${SB_BIN}.bak" "$SB_BIN"
    error "下载失败，已回滚到原版本"
  fi
}

# ---------- 自更新（选项 8）----------
# 与一键引导（bash sb.sh）完全等效：整体拉取 github.com 官方 tarball，
# 清掉旧模块目录后全量复制，避免"只替换部分文件、版本号未同步"以及
# raw.githubusercontent.com CDN 缓存滞后导致的旧版本误判。
sb_self_update() {
  core_root_check
  info "从 github.com 官方仓库更新脚本（与一键引导等效，保留 /etc/sing-box 配置与证书）..."
  local tb dir newver; tb=$(mktemp -d)
  if ! curl -fsL --retry 3 --max-time 120 -o "$tb/repo.tar.gz" \
         "https://github.com/yunjianj/Easy-Singbox/archive/refs/heads/main.tar.gz" \
     || ! gzip -t "$tb/repo.tar.gz" 2>/dev/null; then
    error "github.com tarball 下载失败，更新中止（网络不可达）"; rm -rf "$tb"; return 1
  fi
  tar -xzf "$tb/repo.tar.gz" -C "$tb" 2>/dev/null || true
  dir=$(find "$tb" -maxdepth 1 -type d -name 'Easy-Singbox-*' 2>/dev/null | head -1 || true)
  if [[ -z "$dir" || ! -f "$dir/install.sh" ]]; then
    error "tarball 解压异常，更新中止"; rm -rf "$tb"; return 1
  fi
  # 齐套校验（与 sb.sh 引导一致）：install.sh shebang + 全部运行文件
  if ! head -1 "$dir/install.sh" | grep -qE '^#!.*sh'; then
    error "安装包异常：install.sh 缺少 shebang，更新中止"; rm -rf "$tb"; return 1
  fi
  for f in sb uninstall.sh lib/core.sh lib/init.sh lib/service.sh lib/firewall.sh lib/port_hop.sh \
           lib/cert.sh lib/config.sh lib/node.sh lib/diag.sh \
           lib/protocol/anytls.sh lib/protocol/hysteria2.sh lib/protocol/tuic.sh; do
    if [[ ! -f "$dir/$f" ]]; then
      error "安装包不完整：缺少 $f，更新中止"; rm -rf "$tb"; return 1
    fi
  done

  newver=$(cat "$dir/VERSION" 2>/dev/null | tr -d '[:space:]v' || true)

  # 覆盖本地前展示变更摘要并要求确认（供应链防护：即便更新源被投毒，用户仍可拒绝）
  local changed=() diffcnt=0 f
  local file_list="install.sh sb uninstall.sh VERSION \
           lib/core.sh lib/init.sh lib/service.sh lib/firewall.sh lib/port_hop.sh lib/cert.sh \
           lib/config.sh lib/node.sh lib/diag.sh \
           lib/protocol/anytls.sh lib/protocol/hysteria2.sh lib/protocol/tuic.sh \
           templates/config.json.tpl"
  for f in $file_list; do
    if [[ ! -f "$SB_DIR/$f" ]] || ! cmp -s "$dir/$f" "$SB_DIR/$f"; then
      changed+=("$f"); diffcnt=$((diffcnt+1))
    fi
  done
  if (( diffcnt == 0 )); then
    info "已是最新版本，无文件变更（本地与远程一致）"; rm -rf "$tb"; return 0
  fi
  info "以下 $diffcnt 个文件有变更${newver:+（新版本 v$newver）}，将覆盖本地版本："
  printf '  - %s\n' "${changed[@]}"
  if ! core_prompt_yn "确认覆盖本地文件并更新脚本？"; then
    warn "已取消更新，本地文件未被改动"; rm -rf "$tb"; return 0
  fi

  # 与一键引导完全一致：清掉旧模块目录后整体复制（含新增文件），避免残留旧模块
  rm -rf "$SB_DIR/lib" "$SB_DIR/templates"
  cp -rf "$dir/." "$SB_DIR/" 2>/dev/null || true
  chmod 755 "$SB_DIR/sb" "$SB_DIR/install.sh" "$SB_DIR/uninstall.sh" 2>/dev/null || true
  ln -sf "$SB_DIR/sb" "$SB_SYMLINK" 2>/dev/null || true
  rm -rf "$tb"
  ok "脚本已更新至${newver:+v$newver}（与一键引导等效，配置与证书保留）。请重新运行 sb 以加载新模块。"
}

# ---------- 主页面 ----------
sb_show_menu() {
  local vstat
  vstat=$(sb_script_version_status "$SB_SCRIPT_VERSION") || true
  clear 2>/dev/null || true
  local os arch virt bbr ipregion status inst running ver proto
  os=$(core_detect_os)
  arch=$(core_detect_arch)
  # AES-NI 探测
  local aes="不支持"; grep -q 'aes' /proc/cpuinfo 2>/dev/null && aes="支持"
  virt=$(core_detect_virt)
  bbr=$(core_detect_bbr)
  ipregion=$(core_detect_ip_region)
  # arch 显示名
  local arch_disp="$arch (AES-NI: $aes)"
  IFS='|' read -r inst running ver proto <<< "$(core_sb_status)"

  echo "=============================================================="
  echo -e "      ${C_BOLD}easy-singbox  管理面板${C_RST}  ${C_BOLD}v${SB_SCRIPT_VERSION}${C_RST}"
  echo "--------------------------------------------------------------"
  echo " 系统      : $os"
  echo " 指令集    : $arch_disp"
  echo " 虚拟化    : $virt"
  echo " BBR       : $bbr"
  echo " IP / 地区 : $ipregion"
  echo " Sing-Box  : $inst / $running  v$ver  ($proto 协议在线)"
  case "$vstat" in
    latest)   echo -e " 脚本版本  : v${SB_SCRIPT_VERSION}  ${C_GRN}[已是最新]${C_RST}" ;;
    update:*) local nv="${vstat#update:}"; echo -e " 脚本版本  : v${SB_SCRIPT_VERSION}  ${C_RED}[发现新版本 v${nv}，可执行选项 8 更新]${C_RST}" ;;
    *)        echo -e " 脚本版本  : v${SB_SCRIPT_VERSION}  ${C_YEL}[远程版本未知，请检查网络]${C_RST}" ;;
  esac
  echo "--------------------------------------------------------------"
  if [[ -x "$SB_BIN" ]]; then
    echo " [1] 卸载 Sing-Box"
  else
    echo " [1] 一键安装 Sing-Box"
  fi
  echo " [2] 变更代理配置      (协议 / 端口 / 凭证)"
  echo " [3] 变更证书配置      (HTTP-01 / DNS-01 / 重签)"
  echo " [4] 启动 Sing-Box"
  echo " [5] 停止 Sing-Box"
  echo " [6] 重启 / 查看节点   (reload + 打印节点)"
  echo " [7] 更新 / 切换内核版本"
  echo " [8] 更新脚本            (当前 v$SB_SCRIPT_VERSION)"
  echo " [9] 诊断与日志        (排查节点不通，生成可发送的报告)"
  echo " [0] 退出"
  echo "=============================================================="
  local choice
  choice=$(core_prompt "请选择 [0-9]")
  case "$choice" in
    1)
      if [[ -x "$SB_BIN" ]]; then sb_uninstall; else sb_install; fi
      ;;
    2) config_change || true ;;
    3) cert_change || true ;;
    4)
      if [[ -x "$SB_BIN" ]]; then
        service_start || true
      else
        error "尚未安装 sing-box，请先执行选项 1 安装"
      fi
      ;;
    5)
      if [[ -x "$SB_BIN" ]]; then
        service_stop; ok "sing-box 已停止"
      else
        error "尚未安装 sing-box"
      fi
      ;;
    6)
      if [[ -x "$SB_BIN" ]]; then
        service_restart; ok "sing-box 已重启"
      fi
      node_gen || true
      ;;
    7) sb_version_menu || true ;;
    8) sb_self_update || true ;;
    9) diag_menu || true ;;
    0) info "退出"; exit 0 ;;
    *) warn "无效选择" ;;
  esac
}

main_menu() {
  core_root_check
  while true; do
    sb_show_menu || true
    echo ""
  done
}

# 支持 install.sh exec 传入子命令（如 uninstall），否则进入主页面
# 全局参数：--version X.Y.Z 锁定安装版本
SB_VERSION_OVERRIDE=""
if [[ "${1:-}" == "--version" ]]; then
  SB_VERSION_OVERRIDE="${2:-}"
  shift 2
fi
case "${1:-}" in
  uninstall)      sb_uninstall ;;
  install)        sb_install ;;
  nodes)          node_gen ;;
  debug|diag)     diag_run ;;
  log|logs)
    if [[ "$INIT_SYSTEM" == "openrc" ]]; then
      tail -n 200 /var/log/sing-box/sing-box.log 2>/dev/null || echo "日志文件不可用"
    else
      journalctl -u sing-box -n 200 --no-pager
    fi
    ;;
  *)              main_menu "$@" ;;
esac
